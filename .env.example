# ── Chat backend ──────────────────────────────────────────────────────────────
# "groq"  : use Groq API (recommended for deployment)
# "local" : use Gemma via Ollama (local Docker setup)
CHAT_BACKEND=groq

# ── Groq API (required when CHAT_BACKEND=groq) ────────────────────────────────
# Free tier: ~6,000 requests/day — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=gemma2-9b-it

# ── Ollama / local Gemma (required when CHAT_BACKEND=local) ───────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=gemma2:2b
